#!/bin/sh
set -e

# Maven Wrapper Script
# This script allows you to run Maven commands without requiring a local installation of Maven.
# It will download Maven if it is not already installed.

MAVEN_VERSION=3.8.6
MAVEN_HOME="$HOME/.m2/repository/org/apache/maven/apache-maven/$MAVEN_VERSION"
MAVEN_BIN="$MAVEN_HOME/bin"

if [ ! -d "$MAVEN_HOME" ]; then
  echo "Downloading Maven..."
  curl -sL "https://archive.apache.org/dist/maven/binaries/apache-maven-$MAVEN_VERSION-bin.tar.gz" | tar xz -C "$HOME/.m2/repository/org/apache/maven/apache-maven/"
fi

export PATH="$MAVEN_BIN:$PATH"

exec mvn "$@"